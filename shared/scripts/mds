#!/bin/bash
# mds — Markdown Section selector
# Find a heading in a markdown file and extract just that section.
#
# Usage:
#   mds file.md              # list all headings (a TOC)
#   mds file.md pattern      # match a heading, extract that section
#   mds file.md pattern --raw  # same, but as the section's ORIGINAL SOURCE BYTES
#
# The point is context economy: reading a whole large markdown file to answer
# one question is the expensive mistake. `mds file.md` shows you the shape,
# then `mds file.md <pattern>` gives you only the part you need.
#
# --raw / --source: mds delegates the actual extraction to mdq, which
# re-renders from an AST and normalises formatting (e.g. '*word*' comes back
# as '_word_') — same footgun as calling mdq directly, and the same fix: pass
# --raw through to it, and get the section's original source bytes instead of
# a re-render. See mdq's own header comment for the full rationale and the
# constraints (requires jq, one concrete file, selector must resolve to whole
# section(s)). Only meaningful with a pattern — with no pattern there is no
# single section to slice, so raw/render is silently ignored and the TOC is
# printed either way (#1921: a bare 'mds file.md' erroring here was a
# regression, since that's the documented primary invocation).
#
# Matching is tiered, most precise first, so an ID-like query ('N1') picks 'N1'
# rather than ranking the longer 'N11' above it:
#   1. whole-word, literal        'deploy'      -> '## Deploy'
#   2. substring, literal         'auth'        -> '## Authentication'
#   3. all words in order         'setup toml'  -> '## Setup ... TOML'
#   4. fzf subsequence, IF fzf is installed     'stp' -> '## Setup'
#
# Only tier 4 needs fzf, and it degrades silently when fzf is absent — the
# three plain-grep tiers cover everything documented above, so the script is
# useful on any install. Tier 4 is a nicety, not a dependency.
#
# Requires: the foci mdq wrapper installed beside this script (the extraction
# is delegated to it), plus the upstream mdq binary it wraps. fzf is optional.

set -euo pipefail

# Pull --raw/--source out wherever it appears, so the positional file/pattern
# parsing below sees exactly the argv it saw before this flag existed. When
# neither flag is present, this loop is a no-op passthrough — same args, same
# order — so the rest of the script's behaviour is unchanged byte-for-byte.
# Mirrors mdq's inversion (#1705, Dick 2026-09-10): source bytes by default,
# the re-render on request. mds delegates extraction to mdq, so the two MUST
# agree — if mds kept the old default while mdq flipped, the same section would
# come back in different shapes depending on which tool you happened to reach
# for, which is a worse footgun than the one being fixed.
raw=1
render_flag=()
args=()
for a in "$@"; do
    case "$a" in
        --raw|--source) raw=1; render_flag=() ;;
        --render|--no-raw) raw=0; render_flag=(--render) ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]+"${args[@]}"}"

if [[ $# -lt 1 ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    echo "Usage: mds <file.md> [pattern] [--raw]"
    echo "  No pattern: list headings (--raw/--render are ignored — there's no section to slice)"
    echo "  With pattern: match a heading, extract that section"
    echo "  --raw / --source: extract as original source bytes, not mdq's re-render"
    exit 0
fi

file="$1"
pattern="${2:-}"

headings=$(grep '^#' "$file" 2>/dev/null) || { echo "No headings found in $file" >&2; exit 1; }

if [[ -z "$pattern" ]]; then
    echo "$headings"
    exit 0
fi

# Tier 1: whole-word literal. First so 'N1' doesn't lose to 'N11'.
match=$(echo "$headings" | grep -iwF "$pattern" | head -1) || true

# Tier 2: substring literal — 'auth' -> 'Authentication'.
[[ -z "$match" ]] && match=$(echo "$headings" | grep -iF "$pattern" | head -1) || true

# Tier 3: all words, in order, anything between — 'setup toml' -> 'Setup ... TOML'.
if [[ -z "$match" ]]; then
    words_re=$(printf '%s' "$pattern" | sed 's/[[:space:]]\+/.*/g')
    match=$(echo "$headings" | grep -iE "$words_re" | head -1) || true
fi

# Tier 4: true subsequence matching, only when fzf is present. `fzf -f` is
# filter mode (non-interactive), so this never opens a UI.
if [[ -z "$match" ]] && command -v fzf >/dev/null 2>&1; then
    match=$(echo "$headings" | fzf -f "$pattern" | head -1) || true
fi

if [[ -z "$match" ]]; then
    echo "No match for '$pattern'. Available headings:" >&2
    echo "$headings"
    exit 1
fi

# mdq's selector parser chokes on characters that are common in real headings:
# backticks, angle brackets, square brackets, double quotes. The fixes:
#   1. Strip the heading marker and any further leading '#': mdq's title for
#      '## #2827 foo' is '2827 foo', so a selector with the '#' matches nothing.
#      Strip a closing run too: the title of '## foo ##' is 'foo'.
#   2. Strip backticks — mdq matches a heading's plain text content, not its
#      markdown source, so '#### `foo`' matches on "foo", not "`foo`".
#   3. Wrap in double quotes — mdq's quoted-string syntax is a literal match,
#      so <, [ and friends are not parsed as selector syntax. A backslash or '"' in
#      the heading would end or bend that literal, so escape both.
clean=$(echo "$match" | sed -E 's/^[#[:space:]]+//; s/[[:space:]]+#+[[:space:]]*$//; s/`//g; s/\\/\\\\/g; s/"/\\"/g')

# Call OUR mdq wrapper, the file installed next to this script, not the first
# 'mdq' on PATH (#3075). --raw/--render exist only in the wrapper; where another
# mdq precedes it on PATH (Homebrew's on a Mac), a bare 'mdq' rejected them and
# every extraction failed. Parameter expansion, not dirname: like mdq, this must
# run on a PATH too minimal to hold coreutils. Falls back to PATH when no
# sibling wrapper exists (e.g. mds reached through a lone symlink).
here=${BASH_SOURCE[0]%/*}
[[ "$here" == "${BASH_SOURCE[0]}" ]] && here=.
mdq_cmd=mdq
[[ -x "$here/mdq" && ! -d "$here/mdq" ]] && mdq_cmd="$here/mdq"

if (( raw )); then
    "$mdq_cmd" --raw "# \"$clean\"" "$file"
else
    # Forward the opt-out explicitly: mdq's own default is now raw, so calling
    # it bare here would hand back source bytes and quietly ignore --render.
    "$mdq_cmd" --render "# \"$clean\"" "$file"
fi
